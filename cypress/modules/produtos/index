function acessarProdutos(){
   cy.get('.shop-menu > .nav > :nth-child(2) > a').click()
   cy.url().should('include', '/products')
   cy.get('.features_items').should('exist')
}

function clicarEmProduto(){
   cy.get(':nth-child(3) > .product-image-wrapper > .choose > .nav > li > a').click()
}

function verificarDetalhesDeProduto(path){
   cy.url().should('include', path)
   cy.get(':nth-child(5) > .btn').should('be.visible')
}

function buscarProduto(produto, path){
    cy.get('#search_product').type(produto)
    cy.get('#submit_search').click()
    cy.url().should('include', path)
    cy.get('.title').should('contain.text', 'Searched Products')
}

function verificarProdutos(){
    cy.get('.title').should('contain.text', 'Searched Products')
    cy.get('.features_items').should('exist')
    .and('be.visible')
}

module.exports = {
acessarProdutos,
clicarEmProduto, 
verificarDetalhesDeProduto,
buscarProduto,
verificarProdutos
}